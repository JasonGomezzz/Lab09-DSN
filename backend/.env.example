# Copiar a .env (ignorado por git) y completar con valores propios.
# En EC2/ECS/Lambda NO definir las claves: el SDK usa el IAM Role del recurso.

AWS_REGION=us-east-1
S3_BUCKET=lab-imagenes-<apellido>-<fecha>

# Credenciales locales del usuario app-imagenes-user (solo desarrollo).
# Alternativa recomendada: AWS_PROFILE=app-user y dejar estas dos vacías.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo con credenciales temporales (AWS Academy / Learner Lab / SSO)
AWS_SESSION_TOKEN=
AWS_PROFILE=

PORT=3000

# Orígenes permitidos por CORS en la API (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Vigencia de las presigned URLs, en segundos
UPLOAD_URL_EXPIRES=300
VIEW_URL_EXPIRES=900

# Límites de subida
MAX_SIZE_MB=5
RATE_LIMIT_PER_MINUTE=30
